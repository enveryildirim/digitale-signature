# Yalnızca yerel geliştirme (npm run dev) içindir.
# Canlıda Firebase Hosting bu değerleri /__/firebase/init.json üzerinden otomatik sunar.
# Firebase konsolu > Proje ayarları > Genel > Web uygulaması > SDK yapılandırması
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=proje-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://proje-id-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=proje-id
VITE_FIREBASE_STORAGE_BUCKET=proje-id.firebasestorage.app
VITE_FIREBASE_APP_ID=
