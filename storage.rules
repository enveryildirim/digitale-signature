rules_version = '2';

// Storage kuralları Realtime Database'teki /admins listesini okuyamaz.
// Bu yüzden Firebase konsolunda Authentication > Settings > User actions altından
// "Enable create (sign-up)" KAPATILMALIDIR; böylece yalnızca konsoldan eklenen
// e-posta/parola hesapları (yöneticiler) yükleme yapabilir.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /media/{fileName} {
      // TV'ler token içeren download URL'leri ile okur (kurallardan bağımsız)
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)|video/(mp4|webm|ogg)');
      allow delete: if isAdmin();
    }
  }
}
