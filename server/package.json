{
  "name": "tv-broadcast-server",
  "version": "1.0.0",
  "description": "Backend API & WebSocket server for Kurum İçi Dijital Bilgi Ekranı",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/seed.ts --reset",
