    "test:api": "tsx src/tests/api.test.ts",
    "test:load": "tsx src/tests/loadSimulation.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
