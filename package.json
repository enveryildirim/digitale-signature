{
  "name": "tv-broadcast-system",
  "version": "2.0.0",
  "description": "Kurum İçi Dijital Bilgi Ekranı (Digital Signage) Sistemi - Firebase sürümü",
  "private": true,
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "deploy": "npm run build && npx firebase-tools deploy",
    "deploy:rules": "npx firebase-tools deploy --only database,storage",
    "test:scheduler": "node tests/scheduler.test.mjs",
    "test:api": "node tests/player.test.mjs",
    "test:load": "node tests/loadSimulation.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "digital-signage",
    "kiosk",
    "tv-broadcast",
    "firebase"
  ],
  "author": "",
  "license": "ISC"
}
