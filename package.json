{
  "name": "tv-broadcast-system",
  "version": "1.0.0",
  "description": "Kurum İçi Dijital Bilgi Ekranı (Digital Signage) Sistemi",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server start",
    "reset": "npm --prefix server run reset",
    "test:scheduler": "npm --prefix server run test:scheduler",
    "test:api": "npm --prefix server run test:api",
    "test:load": "npm --prefix server run test:load"
  },
  "keywords": [
    "digital-signage",
    "kiosk",
    "tv-broadcast"
  ],
  "author": "",
  "license": "ISC"
}
